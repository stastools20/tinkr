{
  "cleanUrls": true,
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "query",
          "key": ".*"
        }
      ],
      "dest": "/404.html",
      "status": 404
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}

